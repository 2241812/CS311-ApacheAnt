<?xml version="1.0" encoding="UTF-8"?>
<project name="Team2ApacheAnt" default="run" basedir=".">

    <description>
        Build file for the team's collected Java solutions.
        Handles cleaning, compiling, running, documentation, and packaging.
    </description>

    <!-- ===== Load external properties ===== -->
    <property file="build.properties"/>

    <!-- ===== Project Classpath ===== -->
    <path id="project.classpath">
        <pathelement location="${classes.dir}"/>
    </path>




    <!-- ===== Compile All ===== -->
    <target name="compile-all" depends="init" description="Compiles all Java source code.">
        <javac srcdir="${src.dir}"
               destdir="${classes.dir}"
               includeantruntime="false"
               debug="true"/>
        <echo>Successfully compiled all source files.</echo>
    </target>

    <!-- ===== Compile Single File ===== -->
    <target name="compile-single" depends="init" description="Compiles a specific Java source file.">
        <fail unless="file.to.compile"
              message="You must specify a file to compile using -Dfile.to.compile=path/to/File.java"/>
        <javac srcdir="${src.dir}"
               destdir="${classes.dir}"
               includeantruntime="false"
               debug="true">
            <include name="${file.to.compile}"/>
        </javac>
        <echo>Successfully compiled single file: ${file.to.compile}</echo>
    </target>




    <!-- ===== Run ===== -->
    <target name="run" depends="compile-all" description="Runs the main class.">
        <java classname="${main.class}" fork="true">
            <classpath>
                <path refid="project.classpath"/>
            </classpath>
        </java>
    </target>



    <!-- ===== Documentation ===== -->
    <target name="doc" depends="init" description="Generates Javadoc documentation.">
        <javadoc packagenames="com.team2.*"
                 sourcepath="${src.dir}"
                 destdir="${doc.dir}"
                 author="true"
                 version="true"
                 use="true"
                 windowtitle="${project.name} API Documentation">
            <doctitle><![CDATA[<h1>${project.name}</h1>]]></doctitle>
            <bottom><![CDATA[<i>Copyright © 2025 ${team.name}. All Rights Reserved.</i>]]></bottom>
        </javadoc>
        <echo>Javadoc generated in '${doc.dir}' directory.</echo>
    </target>


    <target name="init" description="Creates necessary directory structure.">
        <tstamp/>
        <mkdir dir="${build.dir}"/>
        <mkdir dir="${classes.dir}"/>
        <mkdir dir="${dist.dir}"/>
        <mkdir dir="${doc.dir}"/>
    </target>


    <!-- ===== Cleaning ===== -->
    <target name="clean" description="Deletes all generated files and directories (Caution! Cannot be undone).">
        <delete dir="${build.dir}"/>
        <delete dir="${dist.dir}"/>
        <delete dir="${doc.dir}"/>
        <echo>Cleaned project directories.</echo>
    </target>


    <!-- ===== Packaging ===== -->
    <target name="jar" depends="compile-all, doc" description="Packages compiled classes and docs into JARs.">
        <!-- Executable JAR -->
        <jar destfile="${dist.dir}/${jar.classes.file}" basedir="${classes.dir}">
            <manifest>
                <attribute name="Main-Class" value="${main.class}"/>
                <attribute name="Implementation-Title" value="${project.name}"/>
                <attribute name="Implementation-Version" value="${project.version}"/>
                <attribute name="Implementation-Vendor" value="${team.name}"/>
            </manifest>
        </jar>
        <echo>Created executable JAR: ${dist.dir}/${jar.classes.file}</echo>

        <!-- Documentation JAR -->
        <jar destfile="${dist.dir}/${jar.doc.file}" basedir="${doc.dir}"/>
        <echo>Created documentation JAR: ${dist.dir}/${jar.doc.file}</echo>
    </target>

    <!-- ===== Full Rebuild ===== -->
    <target name="rebuild" depends="clean, jar" description="Performs a full clean build.">
        <echo>Project has been completely rebuilt.</echo>
    </target>

</project>
